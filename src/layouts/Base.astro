---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Analytics from '../components/Analytics.astro';
import { SITE } from '../site';

interface Props {
  title: string;
  description: string;
  image: string;
  type?: 'website' | 'article';
}

const { title, description, image, type } = Astro.props;
const path = Astro.url.pathname;
const pageTitle = path === '/' ? title : `${title} | ${SITE.name}`;

const nav = [
  { href: '/projects/', label: 'Projects' },
  { href: '/writing/', label: 'Writing' },
  { href: '/about/', label: 'About' },
  { href: '/resume/', label: 'Resume' },
];
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name}: Writing`} href="/rss.xml" />
    <Seo title={pageTitle} description={description} path={path} image={image} type={type} />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">{SITE.name}</a>
        <nav class="site-nav" aria-label="Main">
          {nav.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
          <ThemeToggle />
        </nav>
      </div>
    </header>
    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <a href={SITE.github}>GitHub</a>
        {SITE.linkedin && <a href={SITE.linkedin}>LinkedIn</a>}
        <a href="/rss.xml">RSS</a>
      </div>
    </footer>
  </body>
</html>
